{
  "name": "@makinbakin/sdk",
  "version": "0.0.0-workspace",
  "description": "SDK for building Bakin plugins — UI components, slot types, hooks, and the runtime registerPlugin helper.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./ui": "./src/ui/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./components": "./src/components/index.ts",
    "./slots": "./src/slots/index.tsx",
    "./types": "./src/types/index.ts",
    "./utils": "./src/utils/index.ts",
    "./metadata": "./src/metadata/index.ts",
    "./routing": "./src/routing/index.ts",
    "./testing": "./src/testing/index.ts",
    "./internal": "./src/internal/index.ts",
    "./styles.css": "./styles.css"
  },
  "files": [
    "src",
    "styles.css",
    "README.md"
  ],
  "sideEffects": [
    "./styles.css"
  ],
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@bakin/ui": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markhayden/bakin.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/markhayden/bakin/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/markhayden/bakin/issues"
  },
  "author": "markhayden",
  "license": "Apache-2.0",
  "keywords": [
    "bakin",
    "plugin",
    "sdk",
    "react",
    "orchestration",
    "agents"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
