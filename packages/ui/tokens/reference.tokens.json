            "colorSpace": "srgb",
            "components": [0.937255, 0.266667, 0.266667],
            "hex": "#ef4444"
          }
        }
      },
      "data": {
        "blue": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.223529, 0.529412, 0.898039],
            "hex": "#3987e5"
          }
        },
        "aqua": {
          "$value": {
            "colorSpace": "srgb",
            "components": [0.098039, 0.619608, 0.439216],
