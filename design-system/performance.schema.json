{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bakin.dev/schemas/ui-performance-v1.json",
  "title": "Bakin browser UI performance baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "generatedBy",
    "scope",
    "css",
    "hostInitialJs",
    "sdkUiBundles",
    "vendorChunks",
    "pluginClients"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedBy": { "const": "bun run ui:performance:generate" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repositories", "compatibilityMatrix"],
      "properties": {
        "mode": { "const": "official" },
        "repositories": { "const": ["bakin", "bakin-bits-official"] },
        "compatibilityMatrix": { "const": "design-system/compatibility.json" }
      }
    },
    "css": {
      "type": "object",
      "additionalProperties": false,
      "required": ["canonicalPath", "canonicalBytes", "copyCount", "copyPaths"],
      "properties": {
        "canonicalPath": { "$ref": "#/definitions/path" },
        "canonicalBytes": { "$ref": "#/definitions/bytes" },
        "copyCount": { "type": "integer", "minimum": 1 },
        "copyPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/definitions/path" }
        }
      }
    },
    "hostInitialJs": { "$ref": "#/definitions/artifact" },
    "sdkUiBundles": {
      "type": "array",
      "minItems": 2,
      "items": { "$ref": "#/definitions/sdkEntrypoint" }
    },
    "vendorChunks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/artifact" }
    },
    "pluginClients": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/pluginClient" }
    }
  },
  "definitions": {
    "path": {
      "type": "string",
      "minLength": 1,
      "not": { "pattern": "^(?:/|[A-Za-z]:\\\\|\\.\\./)" }
    },
    "bytes": { "type": "integer", "minimum": 0 },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes"],
      "properties": {
        "path": { "$ref": "#/definitions/path" },
        "bytes": { "$ref": "#/definitions/bytes" }
      }
    },
    "sdkEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "bytes", "reachableBytes"],
      "properties": {
        "name": { "type": "string", "pattern": "^sdk-(?:ui|components|layout|patterns|charts|conversation|content|navigation)$" },
        "path": { "$ref": "#/definitions/path" },
        "bytes": { "$ref": "#/definitions/bytes" },
        "reachableBytes": { "$ref": "#/definitions/bytes" }
      }
    },
    "pluginClient": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "pluginId", "path", "bytes"],
      "properties": {
        "repository": { "enum": ["bakin", "bakin-bits-official"] },
        "pluginId": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/definitions/path" },
        "bytes": { "$ref": "#/definitions/bytes" }
      }
    }
  }
}
