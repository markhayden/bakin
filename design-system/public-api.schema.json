{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bakin.dev/schemas/ui-public-api-v1.json",
  "title": "Bakin focused SDK public API inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedBy", "contracts", "summary", "entrypoints"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedBy": { "const": "bun run ui:public-api:generate" },
    "contracts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["routing", "stylesheet", "privateImplementation"],
      "properties": {
        "routing": { "type": "string", "minLength": 1 },
        "stylesheet": { "const": "@makinbakin/sdk/styles.css" },
        "privateImplementation": { "const": "@bakin/ui" }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entrypoints", "supportedEntrypoints", "frozenLegacyEntrypoints", "valueExports", "typeExports"],
      "properties": {
        "entrypoints": { "type": "integer", "minimum": 1 },
        "supportedEntrypoints": { "type": "integer", "minimum": 1 },
        "frozenLegacyEntrypoints": { "type": "integer", "minimum": 1 },
        "valueExports": { "type": "integer", "minimum": 1 },
        "typeExports": { "type": "integer", "minimum": 1 }
      }
    },
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["specifier", "sourcePath", "domain", "purpose", "status", "newConsumerPolicy", "values", "types"],
        "properties": {
          "specifier": { "type": "string", "pattern": "^@makinbakin/sdk/" },
          "sourcePath": { "type": "string", "pattern": "^packages/sdk/src/.+/index\\.ts$" },
          "domain": { "enum": ["ui", "layout", "patterns", "charts", "conversation", "content", "navigation", "legacy"] },
          "purpose": { "type": "string", "minLength": 1 },
          "status": { "enum": ["supported-prerelease", "migration-only-frozen"] },
          "newConsumerPolicy": { "enum": ["supported", "migration-only"] },
          "values": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "types": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
