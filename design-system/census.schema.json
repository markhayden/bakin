{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://bakin.dev/schemas/ui-census-v1.json",
  "title": "Bakin UI census",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedBy", "scope", "summary", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedBy": { "const": "bun run ui:census:generate" },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "repositories", "includes"],
      "properties": {
        "mode": { "enum": ["official", "partial-core-only"] },
        "repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["bakin", "bakin-bits-official"] }
        },
        "includes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "byKind", "nonVisualAliases"],
      "properties": {
        "total": { "type": "integer", "minimum": 1 },
        "byKind": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "host-route",
            "plugin-route",
            "plugin-slot",
            "plugin-template",
            "shared-component",
            "sdk-ui-export"
          ],
          "properties": {
            "host-route": { "type": "integer", "minimum": 0 },
            "plugin-route": { "type": "integer", "minimum": 0 },
            "plugin-slot": { "type": "integer", "minimum": 0 },
            "plugin-template": { "type": "integer", "minimum": 0 },
            "shared-component": { "type": "integer", "minimum": 0 },
            "sdk-ui-export": { "type": "integer", "minimum": 0 }
          }
        },
        "nonVisualAliases": { "type": "integer", "minimum": 0 }
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/entry" }
    }
  },
  "definitions": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "owner",
        "identity",
        "sourcePath",
        "symbols",
        "exportStatus",
        "classification",
        "evidence"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": [
            "host-route",
            "plugin-route",
            "plugin-slot",
            "plugin-template",
            "shared-component",
            "sdk-ui-export"
          ]
        },
        "owner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "area"],
          "properties": {
            "repository": { "enum": ["bakin", "bakin-bits-official"] },
            "area": { "enum": ["host", "sdk", "plugin"] },
            "pluginId": { "type": "string", "minLength": 1 }
          }
        },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "route": { "type": "string", "minLength": 1 },
            "slot": { "type": "string", "minLength": 1 },
            "component": { "type": "string", "minLength": 1 },
            "symbol": { "type": "string", "minLength": 1 },
            "entrypoint": { "type": "string", "minLength": 1 }
          }
        },
        "sourcePath": {
          "type": "string",
          "minLength": 1,
          "not": { "pattern": "^(?:/|[A-Za-z]:\\\\|\\.\\./)" }
        },
        "symbols": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "exportStatus": { "enum": ["public", "private", "not-applicable"] },
        "classification": {
          "enum": [
            "visual-surface",
            "embedded-surface",
            "non-visual-alias",
            "shared-ui",
            "public-contract"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "path", "detail"],
            "properties": {
              "type": {
                "enum": [
                  "route-definition",
                  "manifest-route",
                  "manifest-slot",
                  "manifest-template",
                  "client-registration",
                  "source-export",
                  "public-export"
                ]
              },
              "path": { "type": "string", "minLength": 1 },
              "detail": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
