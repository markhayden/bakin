#!/bin/bash
# Start OpenClaw container + Bakin dev server
set -euo pipefail
cd "$(dirname "$0")/.."

bash scripts/dev/compose.sh up -d --build openclaw-gateway 2>/dev/null
OPENCLAW_HOME=./dev/openclaw-home OPENCLAW_PATH=./dev/docker/openclaw-shim.sh BAKIN_URL=http://host.docker.internal:3737 bun run server.ts serve
