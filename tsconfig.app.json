{
  "extends": "./tsconfig.json",
  "include": [
    "bun-env.d.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "storybook/**/*.ts",
    "storybook/**/*.tsx",
    "docs/snippets/**/*.ts",
    "docs/snippets/**/*.tsx",
    "dev/**/*.ts",
    "cli/**/*.ts",
    "server.ts",
    "bakin.config.ts",
    "playwright.ui.config.ts",
    "playwright.browser.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/**/dist/**",
    "plugins/**/dist/**",
    "dev/openclaw-home",
    "dev/bakin-instances",
    "tests/fixtures/whiskit"
  ]
}
