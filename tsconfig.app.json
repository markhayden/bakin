{
  "extends": "./tsconfig.json",
  "include": [
    "bun-env.d.ts",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "src/**/*.ts",
    "src/**/*.tsx",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "scripts/**/*.ts",
    "docs/snippets/**/*.ts",
    "docs/snippets/**/*.tsx",
    "dev/**/*.ts",
    "cli/**/*.ts",
    "server.ts",
    "bakin.config.ts"
  ],
  "exclude": [
    "node_modules",
    "packages/**/dist/**",
    "plugins/**/dist/**"
  ]
}
