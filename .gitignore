# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# build output
dist/
/build
/out/
/storybook-static/
/storybook-static-public/
/playwright-report/
/test-results/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
debug-storybook.log
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo

# Next.js leftovers (pre-Bun-migration #148; nothing current generates these,
# but IDE integrations occasionally resurface them)
.next/
next-env.d.ts

# beacon runtime data (unique per installation)
/content/
mc-server.log
mc-server-error.log

# claude code (keep project content, ignore local settings + runtime locks)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# playwright mcp
.playwright-mcp/
.turbo/
**/.astro/

# full-res headshot originals (keep only thumbnails in repo)
public/headshots/full/

# Dev rig (runtime data + secrets)
dev/openclaw-home/
dev/pi-home/
dev/pi-home-sandbox/
dev/bakin-instances/
dev/docker/.env

# Nested node_modules (pnpm workspace symlinks)
**/node_modules/

# packages/host build output
packages/host/dist/

# vendor bundles (generated by scripts/build-vendors.ts)
packages/host/public/vendor/

# compiled Tailwind output (generated by build:css from packages/host/src/globals.css)
packages/host/public/globals.css

# per-plugin build output (generated by scripts/build-plugins.ts)
plugins/*/dist/

# dev-client bundle (built by scripts/dev.ts on `bun run dev`; never embedded)
packages/host/public/__bakin-dev/

# agent-package conversion snapshots — gitignored copies of an agent's
# OpenClaw workspace + Bakin UI assets, captured by scripts/migration/
# snapshot-agent.ts. Used as conversion source for hand-built reference
# packages; never committed.
agents/*/.snapshot/
dist-sdk/
