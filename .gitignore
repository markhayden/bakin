# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!**/.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# beacon runtime data (unique per installation)
/content/
mc-server.log
mc-server-error.log

# claude code (keep project content, ignore local settings)
.claude/settings.local.json

# playwright mcp
.playwright-mcp/
.turbo/

# full-res headshot originals (keep only thumbnails in repo)
public/headshots/full/

# Docker dev environment (runtime data + secrets)
dev/openclaw-home/
dev/docker/.env
dev/docker/auth-profiles.backup.json
