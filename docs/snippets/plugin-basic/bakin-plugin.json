{
  "id": "docs-basic",
  "name": "Docs Basic",
  "version": "0.1.0",
  "bakin": ">=0.1.0",
  "description": "Minimal plugin used by the public Bakin docs.",
  "contributes": {
    "apiRoutes": [
      {
        "method": "GET",
        "path": "/hello",
        "summary": "Say hello",
        "description": "Returns a small JSON payload from the docs example plugin.",
        "visibility": "public",
        "stability": "stable",
        "responses": {
          "200": {
            "description": "Greeting payload"
          }
        }
      }
    ],
    "clientRoutes": [
      {
        "path": "/docs-basic",
        "summary": "Minimal docs plugin page"
      }
    ],
    "nav": [
      {
        "id": "docs-basic",
        "label": "Docs Basic",
        "icon": "Puzzle",
        "href": "/docs-basic",
        "order": 100
      }
    ],
    "routes": [
      {
        "path": "/docs-basic"
      }
    ]
  },
  "permissions": [
    "storage.read"
  ]
}
