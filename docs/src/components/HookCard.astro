---
type Props = {
  id: string
  name: string
  label?: string
  summary?: string
  source: string
  badges?: string[]
}

const { id, name, label, summary, source, badges = [] } = Astro.props
---

<section class="hook-card" id={id}>
  <div class="hook-card__heading">
    <code>{name}</code>
    {label && <span class="hook-card__label">{label}</span>}
    <a class="hook-card__anchor" href={`#${id}`} aria-label={`Link to ${name}`}>
      <svg aria-hidden="true" viewBox="0 0 24 24">
        <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path>
        <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path>
      </svg>
    </a>
  </div>
  <div class="hook-card__box">
    {summary && <p class="hook-card__summary">{summary}</p>}
    <slot />
    <div class="hook-card__meta">
      <code>{source}</code>
      {badges.length > 0 && (
        <span class="hook-card__badges">
          {badges.map((badge) => <span>{badge}</span>)}
        </span>
      )}
    </div>
  </div>
</section>
