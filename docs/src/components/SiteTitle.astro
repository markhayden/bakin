---
import logo from '../assets/bakin-logo.svg'

const { siteTitleHref } = Astro.locals.starlightRoute
---

<a href={siteTitleHref} class="site-title" aria-label="Bakin Docs">
  <img src={logo.src} alt="" aria-hidden="true" />
  <span class="site-title__brand">Bakin</span>
  <span class="site-title__suffix">Docs</span>
</a>
