---
/**
 * Override of Starlight's `PageSidebar` (the right "On this page" rail).
 *
 * For the auto-generated API reference page we replace the default markdown
 * heading TOC with a grouped, method-chipped operation index pulled from
 * docs/public/openapi.json. Every other page falls back to Starlight's
 * default TOC unchanged.
 */
import { readFileSync } from 'node:fs'
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents'
import TableOfContents from 'virtual:starlight/components/TableOfContents'

type OpenApiSpec = {
  paths: Record<string, Record<string, {
    operationId?: string
    tags?: string[]
    summary?: string
  }>>
  tags?: Array<{ name: string }>
}

const slug = Astro.locals.starlightRoute.entry.slug
const isApiPage = slug === 'reference/generated/api'

type ApiOperation = {
  operationId: string
  method: string
  path: string
  tag: string
  summary: string
}

let groups: Array<{ tag: string; operations: ApiOperation[] }> = []
if (isApiPage) {
  const specPath = new URL('../../public/openapi.json', import.meta.url)
  const spec = JSON.parse(readFileSync(specPath, 'utf8')) as OpenApiSpec
  const operations: ApiOperation[] = []
  for (const [path, methods] of Object.entries(spec.paths)) {
    for (const [methodKey, op] of Object.entries(methods)) {
      const method = methodKey.toUpperCase()
      operations.push({
        operationId: op.operationId ?? `${method}-${path}`,
        method,
        path: path.replace(/\{([^}]+)\}/g, ':$1'),
        tag: op.tags?.[0] ?? 'Other',
        summary: op.summary ?? `${method} ${path}`,
      })
    }
  }
  const tagOrder = (tag: string) => (tag === 'Core' ? '00' : `10 ${tag}`)
  const methodOrder: Record<string, number> = { GET: 0, POST: 1, PUT: 2, PATCH: 3, DELETE: 4, OPTIONS: 5, HEAD: 6 }
  operations.sort((a, b) =>
    tagOrder(a.tag).localeCompare(tagOrder(b.tag)) ||
    a.path.localeCompare(b.path) ||
    (methodOrder[a.method] ?? 99) - (methodOrder[b.method] ?? 99),
  )
  const grouped = new Map<string, ApiOperation[]>()
  for (const op of operations) {
    const list = grouped.get(op.tag) ?? []
    list.push(op)
    grouped.set(op.tag, list)
  }
  groups = [...grouped.entries()].map(([tag, ops]) => ({ tag, operations: ops }))
}
---

{isApiPage ? (
  <>
    <div class="lg:sl-hidden">
      <details class="api-toc-mobile">
        <summary>On this page</summary>
        <nav aria-label="API operations">
          {groups.map(({ tag, operations }) => (
            <div class="api-toc-group">
              <h2>{tag}</h2>
              <ul>
                {operations.map(op => (
                  <li>
                    <a href={`#${op.operationId}`} title={op.summary}>
                      <span class={`api-toc-method api-toc-method--${op.method.toLowerCase()}`}>{op.method}</span>
                      <code class="api-toc-path">{op.path}</code>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </details>
    </div>
    <div class="right-sidebar-panel sl-hidden lg:sl-block">
      <div class="sl-container">
        <nav aria-labelledby="api-on-this-page" class="api-toc">
          <h2 id="api-on-this-page">On this page</h2>
          {groups.map(({ tag, operations }) => (
            <div class="api-toc-group">
              <h3>{tag}</h3>
              <ul>
                {operations.map(op => (
                  <li>
                    <a href={`#${op.operationId}`} title={op.summary}>
                      <span class={`api-toc-method api-toc-method--${op.method.toLowerCase()}`}>{op.method}</span>
                      <code class="api-toc-path">{op.path}</code>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </div>
    </div>
  </>
) : (
  Astro.locals.starlightRoute.toc && (
    <>
      <div class="lg:sl-hidden">
        <MobileTableOfContents />
      </div>
      <div class="right-sidebar-panel sl-hidden lg:sl-block">
        <div class="sl-container">
          <TableOfContents />
        </div>
      </div>
    </>
  )
)}

<style>
  @layer starlight.core {
    .right-sidebar-panel {
      padding: 1rem var(--sl-sidebar-pad-x);
    }
    .sl-container {
      width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    }
    @media (min-width: 72rem) {
      .sl-container {
        max-width: calc(
          (
            (
              100vw - var(--sl-sidebar-width) - 2 * var(--sl-content-pad-x) - 2 *
                var(--sl-sidebar-pad-x)
            ) * 0.25
          )
        );
      }
    }
  }
</style>
