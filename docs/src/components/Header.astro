---
const normalizePath = (path: string) => {
  if (!path) return '/'
  return path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path
}

const currentPath = normalizePath(Astro.url.pathname)

const exploreLinks = [
  {
    label: 'Tasks',
    href: '/features/tasks',
    description: 'Autonomous execution. Full visibility.',
  },
  {
    label: 'Planning',
    href: '/features/planning',
    description: 'Strategy, timing, and narrative in one place',
  },
  {
    label: 'Memory',
    href: '/features/memory',
    description: 'Conversations, assets, and decisions that stick',
  },
  {
    label: 'Operations',
    href: '/features/operations',
    description: "See what's running, what it costs, and where to tune",
  },
] as const

const navLinks = [
  { label: 'Explore', href: '/features', matchNested: true, children: exploreLinks },
  { label: 'Customize', href: '/customize' },
  { label: 'Possibilities', href: '/possibilities' },
  { label: 'About', href: '/about' },
  { label: 'Docs', href: '/docs', matchNested: true },
  { label: 'Contact', href: '/contact' },
] as const

const isLinkActive = (href: string, matchNested = false) => {
  const normalizedHref = normalizePath(href)

  if (currentPath === normalizedHref) return true
  return matchNested && normalizedHref !== '/' && currentPath.startsWith(`${normalizedHref}/`)
}
---

<nav class="bakin-site-header" aria-label="Main navigation">
  <div class="bakin-site-header__inner">
    <a href="/" class="bakin-site-header__brand" aria-label="Bakin home">
      <img src="/docs/images/bakin-hop.svg" alt="Bakin" />
      <span>Bakin</span>
    </a>

    <div class="bakin-site-header__links" aria-label="Primary">
      {
        navLinks.map((link) => {
          const active = isLinkActive(link.href, Boolean(link.matchNested))

          return 'children' in link ? (
            <div class="bakin-site-header__link-group">
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'bakin-site-header__link',
                  'bakin-site-header__link--parent',
                  active && 'bakin-site-header__link--active',
                ]}
              >
                {link.label}
                <svg
                  class="bakin-site-header__chevron"
                  viewBox="0 0 12 12"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M2.5 4.5 6 8l3.5-3.5" />
                </svg>
              </a>

              <div class="bakin-site-header__submenu">
                <div class="bakin-site-header__submenu-panel">
                  {
                    link.children.map((child) => {
                      const childActive = isLinkActive(child.href)

                      return (
                        <a
                          href={child.href}
                          aria-current={childActive ? 'page' : undefined}
                          class:list={[
                            'bakin-site-header__submenu-link',
                            childActive && 'bakin-site-header__submenu-link--active',
                          ]}
                        >
                          <div class="bakin-site-header__submenu-label">{child.label}</div>
                          <div class="bakin-site-header__submenu-description">{child.description}</div>
                        </a>
                      )
                    })
                  }
                </div>
              </div>
            </div>
          ) : (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'bakin-site-header__link',
                active && 'bakin-site-header__link--active',
              ]}
            >
              {link.label}
            </a>
          )
        })
      }
    </div>

    <a href="/contact/" class="bakin-site-header__cta" data-cta="docs_header_contact">
      Request Access
    </a>

    <details class="bakin-site-header__mobile">
      <summary aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <div class="bakin-site-header__mobile-panel">
        {
          navLinks.map((link) => {
            const active = isLinkActive(link.href, Boolean(link.matchNested))

            return 'children' in link ? (
              <div class="bakin-site-header__mobile-group">
                <a
                  href={link.href}
                  aria-current={active ? 'page' : undefined}
                  class:list={[
                    'bakin-site-header__mobile-link',
                    active && 'bakin-site-header__mobile-link--active',
                  ]}
                >
                  {link.label}
                </a>
                <div class="bakin-site-header__mobile-children">
                  {
                    link.children.map((child) => {
                      const childActive = isLinkActive(child.href)

                      return (
                        <a
                          href={child.href}
                          aria-current={childActive ? 'page' : undefined}
                          class:list={[
                            'bakin-site-header__mobile-child',
                            childActive && 'bakin-site-header__mobile-child--active',
                          ]}
                        >
                          {child.label}
                        </a>
                      )
                    })
                  }
                </div>
              </div>
            ) : (
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'bakin-site-header__mobile-link',
                  active && 'bakin-site-header__mobile-link--active',
                ]}
              >
                {link.label}
              </a>
            )
          })
        }
        <a href="/contact/" class="bakin-site-header__mobile-cta" data-cta="docs_mobile_contact">
          Request Access
        </a>
      </div>
    </details>
  </div>
</nav>

<style>
  .bakin-site-header {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 14, 14, 0.8);
    backdrop-filter: blur(24px);
    box-shadow: 0 0 40px rgba(227, 0, 113, 0.08);
  }

  .bakin-site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1rem 1.5rem;
  }

  .bakin-site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    text-decoration: none;
  }

  .bakin-site-header__brand img {
    width: auto;
    height: 1.25rem;
    flex-shrink: 0;
    filter: brightness(0) saturate(100%) invert(69%) sepia(36%) saturate(1831%) hue-rotate(292deg) brightness(102%) contrast(101%);
  }

  .bakin-site-header__brand span,
  .bakin-site-header__link,
  .bakin-site-header__cta,
  .bakin-site-header__mobile-link,
  .bakin-site-header__mobile-cta {
    font-family: var(--font-bakin-body);
    font-weight: 700;
    text-transform: uppercase;
  }

  .bakin-site-header__brand span {
    font-style: italic;
    font-size: 1rem;
    line-height: 1.5rem;
    color: #ffffff;
    letter-spacing: 0.1em;
  }

  .bakin-site-header__links {
    display: none;
    align-items: center;
    gap: 2.5rem;
  }

  .bakin-site-header__link {
    color: #aeaaaa;
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.025em;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .bakin-site-header__link:hover,
  .bakin-site-header__link--active {
    color: var(--bakin-brand-pink);
  }

  .bakin-site-header__link-group {
    position: relative;
  }

  .bakin-site-header__link--parent {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .bakin-site-header__chevron {
    width: 0.75rem;
    height: 0.75rem;
    transition: transform 200ms ease;
  }

  .bakin-site-header__link-group:hover .bakin-site-header__chevron,
  .bakin-site-header__link-group:focus-within .bakin-site-header__chevron {
    transform: rotate(180deg);
  }

  .bakin-site-header__submenu {
    pointer-events: none;
    position: absolute;
    top: 100%;
    left: 50%;
    z-index: 50;
    width: 18rem;
    padding-top: 0.75rem;
    opacity: 0;
    transform: translateX(-50%);
    transition: opacity 200ms ease;
  }

  .bakin-site-header__link-group:hover .bakin-site-header__submenu,
  .bakin-site-header__link-group:focus-within .bakin-site-header__submenu {
    pointer-events: auto;
    opacity: 1;
  }

  .bakin-site-header__submenu-panel {
    padding: 0.75rem;
    border: 1px solid rgba(74, 71, 71, 0.15);
    border-radius: 1.5rem;
    background: rgba(27, 25, 25, 0.95);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.38);
    backdrop-filter: blur(24px);
  }

  .bakin-site-header__submenu-link {
    display: block;
    padding: 0.75rem 1rem;
    border-radius: 1rem;
    text-decoration: none;
    transition: background-color 160ms ease;
  }

  .bakin-site-header__submenu-link:hover,
  .bakin-site-header__submenu-link--active {
    background: rgba(33, 31, 31, 0.8);
  }

  .bakin-site-header__submenu-label {
    color: #ffffff;
    font-family: var(--font-bakin-body);
    font-size: 0.875rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.25rem;
    text-transform: uppercase;
  }

  .bakin-site-header__submenu-link--active .bakin-site-header__submenu-label {
    color: var(--bakin-brand-pink);
  }

  .bakin-site-header__submenu-description {
    margin-top: 0.25rem;
    color: #aeaaaa;
    font-size: 0.75rem;
    line-height: 1rem;
  }

  .bakin-site-header__cta {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 1.25rem;
    border: 1px solid rgba(255, 112, 158, 0.6);
    border-radius: 0.5rem;
    background: rgba(255, 112, 158, 0.1);
    color: var(--bakin-brand-pink);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition:
      background-color 300ms ease,
      color 300ms ease,
      filter 300ms ease;
  }

  .bakin-site-header__cta:hover {
    background: var(--bakin-brand-pink);
    color: #2b1019;
  }

  .bakin-site-header__mobile {
    position: relative;
  }

  .bakin-site-header__mobile summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(120, 117, 116, 0.22);
    border-radius: 0.5rem;
    background: rgba(39, 37, 37, 0.5);
    color: #ded8d8;
    cursor: pointer;
    list-style: none;
  }

  .bakin-site-header__mobile summary::-webkit-details-marker {
    display: none;
  }

  .bakin-site-header__mobile summary span {
    position: absolute;
    width: 1.1rem;
    height: 1px;
    background: currentColor;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  .bakin-site-header__mobile summary span:nth-child(1) {
    transform: translateY(-0.32rem);
  }

  .bakin-site-header__mobile summary span:nth-child(3) {
    transform: translateY(0.32rem);
  }

  .bakin-site-header__mobile[open] summary span:nth-child(1) {
    transform: rotate(45deg);
  }

  .bakin-site-header__mobile[open] summary span:nth-child(2) {
    opacity: 0;
  }

  .bakin-site-header__mobile[open] summary span:nth-child(3) {
    transform: rotate(-45deg);
  }

  .bakin-site-header__mobile-panel {
    position: fixed;
    top: calc(var(--sl-nav-height) + 0.75rem);
    right: 1rem;
    left: 1rem;
    display: grid;
    gap: 0.25rem;
    max-height: calc(100svh - var(--sl-nav-height) - 1.5rem);
    overflow-y: auto;
    padding: 1rem;
    border: 1px solid rgba(120, 117, 116, 0.18);
    border-radius: 1.5rem;
    background: rgba(27, 25, 25, 0.96);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(24px);
  }

  .bakin-site-header__mobile-link,
  .bakin-site-header__mobile-child,
  .bakin-site-header__mobile-cta {
    display: block;
    border-radius: 1rem;
    padding: 0.95rem 1rem;
    color: #fff;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .bakin-site-header__mobile-link:hover,
  .bakin-site-header__mobile-link--active {
    background: rgba(39, 37, 37, 0.7);
    color: var(--bakin-brand-pink);
  }

  .bakin-site-header__mobile-children {
    display: grid;
    gap: 0.25rem;
    padding: 0.25rem 0 0.5rem 1rem;
  }

  .bakin-site-header__mobile-child {
    color: #aeaaaa;
    font-size: 0.875rem;
    line-height: 1.25rem;
  }

  .bakin-site-header__mobile-child:hover,
  .bakin-site-header__mobile-child--active {
    color: var(--bakin-brand-pink);
    background: rgba(39, 37, 37, 0.45);
  }

  .bakin-site-header__mobile-cta {
    margin-top: 0.5rem;
    background: var(--bakin-brand-pink);
    color: #2b1019;
    text-align: center;
  }

  @media (min-width: 48rem) {
    .bakin-site-header__inner {
      padding: 1rem 3rem;
    }

    .bakin-site-header__links {
      display: flex;
    }

    .bakin-site-header__cta {
      display: inline-flex;
    }

    .bakin-site-header__mobile {
      display: none;
    }
  }
</style>
