---
const normalizePath = (path: string) => {
  if (!path) return '/'
  return path.length > 1 && path.endsWith('/') ? path.slice(0, -1) : path
}

const currentPath = normalizePath(Astro.url.pathname)

const navLinks = [
  { label: 'Explore', href: '/features', matchNested: true },
  { label: 'Customize', href: '/customize' },
  { label: 'Possibilities', href: '/possibilities' },
  { label: 'About', href: '/about' },
  { label: 'Docs', href: '/docs', matchNested: true },
  { label: 'Contact', href: '/contact' },
] as const

const isLinkActive = (href: string, matchNested = false) => {
  const normalizedHref = normalizePath(href)

  if (currentPath === normalizedHref) return true
  return matchNested && normalizedHref !== '/' && currentPath.startsWith(`${normalizedHref}/`)
}
---

<nav class="bakin-site-header" aria-label="Main navigation">
  <div class="bakin-site-header__inner">
    <a href="/" class="bakin-site-header__brand" aria-label="Bakin home">
      <img src="/docs/images/bakin-hop.svg" alt="Bakin" />
      <span>Bakin</span>
    </a>

    <div class="bakin-site-header__links" aria-label="Primary">
      {
        navLinks.map((link) => {
          const active = isLinkActive(link.href, Boolean(link.matchNested))

          return (
            <a
              href={link.href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'bakin-site-header__link',
                active && 'bakin-site-header__link--active',
              ]}
            >
              {link.label}
            </a>
          )
        })
      }
    </div>

    <a href="/contact/" class="bakin-site-header__cta" data-cta="docs_header_contact">
      Request Access
    </a>

    <details class="bakin-site-header__mobile">
      <summary aria-label="Toggle menu">
        <span></span>
        <span></span>
        <span></span>
      </summary>
      <div class="bakin-site-header__mobile-panel">
        {
          navLinks.map((link) => {
            const active = isLinkActive(link.href, Boolean(link.matchNested))

            return (
              <a
                href={link.href}
                aria-current={active ? 'page' : undefined}
                class:list={[
                  'bakin-site-header__mobile-link',
                  active && 'bakin-site-header__mobile-link--active',
                ]}
              >
                {link.label}
              </a>
            )
          })
        }
        <a href="/contact/" class="bakin-site-header__mobile-cta" data-cta="docs_mobile_contact">
          Request Access
        </a>
      </div>
    </details>
  </div>
</nav>

<style>
  .bakin-site-header {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 14, 14, 0.8);
    backdrop-filter: blur(24px);
    box-shadow: 0 0 40px rgba(227, 0, 113, 0.08);
  }

  .bakin-site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    padding: 1rem 1.5rem;
  }

  .bakin-site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: #ffffff;
    text-decoration: none;
  }

  .bakin-site-header__brand img {
    width: auto;
    height: 1.25rem;
    flex-shrink: 0;
    filter: brightness(0) saturate(100%) invert(69%) sepia(36%) saturate(1831%) hue-rotate(292deg) brightness(102%) contrast(101%);
  }

  .bakin-site-header__brand span,
  .bakin-site-header__link,
  .bakin-site-header__cta,
  .bakin-site-header__mobile-link,
  .bakin-site-header__mobile-cta {
    font-family: var(--font-bakin-body);
    font-weight: 700;
    text-transform: uppercase;
  }

  .bakin-site-header__brand span {
    font-style: italic;
    font-size: 1rem;
    line-height: 1.5rem;
    color: #ffffff;
    letter-spacing: 0.1em;
  }

  .bakin-site-header__links {
    display: none;
    align-items: center;
    gap: 2.5rem;
  }

  .bakin-site-header__link {
    color: #aeaaaa;
    font-size: 0.75rem;
    line-height: 1rem;
    letter-spacing: 0.025em;
    text-decoration: none;
    transition: color 160ms ease;
  }

  .bakin-site-header__link:hover,
  .bakin-site-header__link--active {
    color: var(--bakin-brand-pink);
  }

  .bakin-site-header__cta {
    display: none;
    align-items: center;
    justify-content: center;
    padding: 0.375rem 1.25rem;
    border: 1px solid rgba(255, 112, 158, 0.6);
    border-radius: 0.5rem;
    background: rgba(255, 112, 158, 0.1);
    color: var(--bakin-brand-pink);
    font-size: 0.6875rem;
    line-height: 1rem;
    letter-spacing: 0.03em;
    text-decoration: none;
    transition:
      background-color 300ms ease,
      color 300ms ease,
      filter 300ms ease;
  }

  .bakin-site-header__cta:hover {
    background: var(--bakin-brand-pink);
    color: #2b1019;
  }

  .bakin-site-header__mobile {
    position: relative;
  }

  .bakin-site-header__mobile summary {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(120, 117, 116, 0.22);
    border-radius: 0.5rem;
    background: rgba(39, 37, 37, 0.5);
    color: #ded8d8;
    cursor: pointer;
    list-style: none;
  }

  .bakin-site-header__mobile summary::-webkit-details-marker {
    display: none;
  }

  .bakin-site-header__mobile summary span {
    position: absolute;
    width: 1.1rem;
    height: 1px;
    background: currentColor;
    transition:
      transform 160ms ease,
      opacity 160ms ease;
  }

  .bakin-site-header__mobile summary span:nth-child(1) {
    transform: translateY(-0.32rem);
  }

  .bakin-site-header__mobile summary span:nth-child(3) {
    transform: translateY(0.32rem);
  }

  .bakin-site-header__mobile[open] summary span:nth-child(1) {
    transform: rotate(45deg);
  }

  .bakin-site-header__mobile[open] summary span:nth-child(2) {
    opacity: 0;
  }

  .bakin-site-header__mobile[open] summary span:nth-child(3) {
    transform: rotate(-45deg);
  }

  .bakin-site-header__mobile-panel {
    position: fixed;
    top: calc(var(--sl-nav-height) + 0.75rem);
    right: 1rem;
    left: 1rem;
    display: grid;
    gap: 0.25rem;
    max-height: calc(100svh - var(--sl-nav-height) - 1.5rem);
    overflow-y: auto;
    padding: 1rem;
    border: 1px solid rgba(120, 117, 116, 0.18);
    border-radius: 1.5rem;
    background: rgba(27, 25, 25, 0.96);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.42);
    backdrop-filter: blur(24px);
  }

  .bakin-site-header__mobile-link,
  .bakin-site-header__mobile-cta {
    display: block;
    border-radius: 1rem;
    padding: 0.95rem 1rem;
    color: #fff;
    font-size: 1rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }

  .bakin-site-header__mobile-link:hover,
  .bakin-site-header__mobile-link--active {
    background: rgba(39, 37, 37, 0.7);
    color: var(--bakin-brand-pink);
  }

  .bakin-site-header__mobile-cta {
    margin-top: 0.5rem;
    background: var(--bakin-brand-pink);
    color: #2b1019;
    text-align: center;
  }

  @media (min-width: 48rem) {
    .bakin-site-header__inner {
      padding: 1rem 3rem;
    }

    .bakin-site-header__links {
      display: flex;
    }

    .bakin-site-header__cta {
      display: inline-flex;
    }

    .bakin-site-header__mobile {
      display: none;
    }
  }
</style>
