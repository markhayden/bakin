{
  "id": "brands",
  "name": "Brands",
  "version": "0.1.0",
  "bakin": ">=1.0.0",
  "description": "Structured brand definitions — voice, palette, rules, and reference assets injected per-task so agent output stays on brand",
  "contentFiles": [],
  "secrets": [],
  "dependencies": [],
  "permissions": [
    "storage.read",
    "storage.write",
    "tasks.read",
    "tasks.write",
    "assets.read",
    "assets.write",
    "search.write"
  ],
  "contributes": {
    "execTools": [
      {
        "name": "bakin_exec_brands_list",
        "summary": "List brands"
      },
      {
        "name": "bakin_exec_brands_get",
        "summary": "Get a brand"
      },
      {
        "name": "bakin_exec_brands_write_doc",
        "reports": ["brands:doc"],
        "summary": "Write a draft-brand guideline or lesson doc"
      },
      {
        "name": "bakin_exec_brands_update_manifest",
        "reports": ["brands:brand"],
        "summary": "Update a draft-brand manifest"
      },
      {
        "name": "bakin_exec_brands_add_lesson",
        "reports": ["brands:doc"],
        "summary": "Bank a brand lesson"
      },
      {
        "name": "bakin_exec_brands_read_doc",
        "summary": "Read a brand doc"
      }
    ],
    "entities": [
      {
        "kind": "brand",
        "label": "Brand",
        "icon": "Paintbrush",
        "href": "/brands/{id}"
      },
      {
        "kind": "doc",
        "label": "Brand document",
        "icon": "FileText",
        "href": "/brands/{brandId}/docs/{kind}/{name}"
      }
    ],
    "apiRoutes": [
      {
        "method": "GET",
        "path": "/",
        "summary": "List brands"
      },
      {
        "method": "POST",
        "path": "/",
        "summary": "Create a brand (scaffolds starter guidelines)"
      },
      {
        "method": "GET",
        "path": "/:brandId",
        "summary": "Brand manifest + doc listings + fingerprint"
      },
      {
        "method": "PUT",
        "path": "/:brandId",
        "summary": "Replace a brand manifest"
      },
      {
        "method": "DELETE",
        "path": "/:brandId",
        "summary": "Delete a brand"
      },
      {
        "method": "GET",
        "path": "/:brandId/docs/:kind/:name",
        "summary": "Read a guideline or lesson doc"
      },
      {
        "method": "PUT",
        "path": "/:brandId/docs/:kind/:name",
        "summary": "Write a guideline or lesson doc"
      },
      {
        "method": "DELETE",
        "path": "/:brandId/docs/:kind/:name",
        "summary": "Delete a guideline or lesson doc"
      }
    ],
    "nav": [
      {
        "id": "brands",
        "label": "Branding",
        "icon": "Paintbrush",
        "href": "/brands",
        "order": 10,
        "section": "create"
      }
    ],
    "slots": [
      "page:/brands",
      "page:/brands/:brandId",
      "page:/brands/:brandId/docs",
      "task-brand"
    ]
  }
}
