{
  "id": "home",
  "name": "Home",
  "version": "0.1.0",
  "bakin": ">=1.0.0",
  "description": "The page Bakin opens on: meet your main agent, ask for something, find what to add next",
  "contentFiles": [],
  "secrets": [],
  "dependencies": [],
  "permissions": [
    "storage.read",
    "storage.write",
    "runtime.read",
    "runtime.agents",
    "events.emit"
  ],
  "contributes": {
    "apiRoutes": [
      {
        "method": "GET",
        "path": "/state",
        "summary": "What Home shows now"
      },
      {
        "method": "POST",
        "path": "/hello",
        "summary": "Record that the person said hello"
      },
      {
        "method": "POST",
        "path": "/introduction",
        "summary": "Introduce the main agent"
      },
      {
        "method": "POST",
        "path": "/introduction/skip",
        "summary": "Skip the introduction"
      }
    ],
    "slots": [
      "page:/home"
    ]
  }
}
