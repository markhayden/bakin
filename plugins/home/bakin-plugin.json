{
  "id": "home",
  "name": "Home",
  "version": "0.1.0",
  "bakin": ">=1.0.0",
  "description": "The page Bakin opens on: meet your main agent, ask for something, find what to add next",
  "contentFiles": [],
  "secrets": [],
  "dependencies": [],
  "permissions": [
    "storage.read",
    "storage.write",
    "runtime.read",
    "runtime.agents",
    "events.emit"
  ],
  "contributes": {
    "apiRoutes": [
      {
        "method": "GET",
        "path": "/state",
        "summary": "What Home shows now"
      },
      {
        "method": "POST",
        "path": "/introduction",
        "summary": "Introduce the main agent"
      },
      {
        "method": "POST",
        "path": "/first-request",
        "summary": "Record the first thing the person asked for"
      },
      {
        "method": "GET",
        "path": "/tour",
        "summary": "The tour of Bakin"
      },
      {
        "method": "POST",
        "path": "/starters/:id/used",
        "summary": "Record that a starter was picked"
      },
      {
        "method": "GET",
        "path": "/page-introductions",
        "summary": "The pages that still introduce themselves"
      },
      {
        "method": "POST",
        "path": "/page-introductions/:id/close",
        "summary": "Close a page's introduction"
      },
      {
        "method": "POST",
        "path": "/suggestions/:id/dismiss",
        "summary": "Put a suggestion away"
      },
      {
        "method": "POST",
        "path": "/introduction/skip",
        "summary": "Skip the introduction"
      }
    ],
    "nav": [
      {
        "id": "home",
        "label": "Home",
        "icon": "House",
        "href": "/",
        "order": 1
      }
    ],
    "slots": [
      "page:/home"
    ]
  }
}
