{
  "id": "chat",
  "name": "Chat",
  "version": "0.1.0",
  "bakin": ">=1.0.0",
  "description": "Direct conversations with your agents — streamed multi-chat sessions from the Bakin UI, runtime-agnostic via the adapter layer",
  "contentFiles": [],
  "secrets": [],
  "dependencies": [],
  "permissions": [
    "storage.read",
    "storage.write",
    "events.emit",
    "runtime.read",
    "runtime.agents",
    "runtime.messaging",
    "search.write"
  ],
  "contributes": {
    "apiRoutes": [
      {
        "method": "GET",
        "path": "/chats",
        "summary": "List chats (optionally filtered by agent)"
      },
      {
        "method": "POST",
        "path": "/chats",
        "summary": "Create a new chat with an agent"
      },
      {
        "method": "GET",
        "path": "/chats/:chatId",
        "summary": "Get a chat and its messages"
      },
      {
        "method": "DELETE",
        "path": "/chats/:chatId",
        "summary": "Delete a chat and its transcript"
      },
      {
        "method": "POST",
        "path": "/chats/:chatId/messages",
        "summary": "Send a message; reply streams over the SSE bus as chat.chunk events"
      },
      {
        "method": "PATCH",
        "path": "/chats/:chatId",
        "summary": "Rename or pin a chat"
      },
      {
        "method": "POST",
        "path": "/chats/:chatId/seen",
        "summary": "Mark a chat as seen (clears unread)"
      },
      {
        "method": "POST",
        "path": "/chats/:chatId/abort",
        "summary": "Stop the in-flight reply"
      },
      {
        "method": "POST",
        "path": "/chats/:chatId/attachments",
        "summary": "Upload an image attachment (multipart, image/* only)"
      },
      {
        "method": "GET",
        "path": "/chats/:chatId/attachments/:name",
        "summary": "Serve a chat attachment"
      },
      {
        "method": "GET",
        "path": "/capabilities",
        "summary": "Whether an agent's model accepts image input (?agent=)"
      }
    ],
    "nav": [
      {
        "id": "chat",
        "label": "Chat",
        "icon": "MessageSquare",
        "href": "/chat",
        "order": 5
      }
    ],
    "slots": [
      "page:/chat",
      "page:/chat/[chatId]",
      "page:/chat/new",
      "nav-badge-providers"
    ]
  }
}
