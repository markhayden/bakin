# OpenClaw Docker Environment
# Copy to .env and fill in your values: cp .env.example .env

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Which LLM provider to use. Determines which key is required.
#   codex     — OpenAI Codex OAuth (ChatGPT Plus/Pro subscription, no API credits needed)
#   openai    — OpenAI API key (requires credits on platform.openai.com)
#   anthropic — Anthropic API key (Claude models)
LLM_PROVIDER=codex

# Set the key that matches your LLM_PROVIDER above:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Optional ──────────────────────────────────────────────────────────────────
# Gateway auth token (auto-generated by setup.sh if blank)
OPENCLAW_GATEWAY_TOKEN=

# Discord bot token (from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=

# Discord server (guild) ID — right-click your server → Copy Server ID
DISCORD_GUILD_ID=

# Your Discord user ID — right-click yourself → Copy User ID
DISCORD_USER_ID=

# Discord pairing code — DM the bot once, it replies with a code.
# Paste it here and re-run setup to auto-approve.
DISCORD_PAIRING_CODE=
