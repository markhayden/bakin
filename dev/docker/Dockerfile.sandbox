# Full-sandbox image: the OpenClaw runtime + bun, so Bakin can run INSIDE the
# container (clean Linux box) for end-to-end onboarding tests.
#
# The OpenClaw gateway stays the container's main process (PID 1, keeps it
# alive). Bakin is run via `docker exec` sessions (instance shell / run /
# --preconfigure) — no in-container process manager.
#
# The Bakin repo is mounted at /bakin at runtime (not copied), so the build
# context stays tiny and edits are live.
ARG OPENCLAW_IMAGE_TAG=latest
FROM ghcr.io/openclaw/openclaw:${OPENCLAW_IMAGE_TAG}

USER root
# The OpenClaw image is node-only; Bakin needs bun. bun's installer needs unzip.
RUN apt-get update \
  && apt-get install -y --no-install-recommends unzip \
  && rm -rf /var/lib/apt/lists/* \
  && curl -fsSL https://bun.sh/install | BUN_INSTALL=/usr/local bash \
  && bun --version
USER node
