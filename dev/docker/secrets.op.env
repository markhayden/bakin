# 1Password secret references for the OpenClaw dev rig.
#
# These are op:// REFERENCES, not secrets — safe to commit. At `instance up`,
# the host `op` CLI (authed via OP_SERVICE_ACCOUNT_TOKEN) resolves each one and
# only the resolved VALUES are injected into the disposable container.
#
# Format: KEY=op://<vault>/<item>/<field>   (one per line; # comments allowed)
# Adjust the vault/item/field segments to match your service account's layout.

# brave-search — the only default tool. Required.
# Vault "Claw Keys" has a space; if it ever fails to resolve, use the vault ID:
#   op://i4sm7qsquijaomawms7cwnfdiu/brave-search/credential
BRAVE_API_KEY=op://Claw Keys/brave-search/credential

# Discord channel — present here ⇒ `up` configures it. Comment out to disable.
DISCORD_BOT_TOKEN=op://Claw Keys/discord-bot-token/credential
DISCORD_GUILD_ID=op://Claw Keys/discord-guild-id/credential
DISCORD_USER_ID=op://Claw Keys/discord-user-id-penelope/credential

# ── Optional (uncomment + add the item to the service account to enable) ──────
# Codex uses a fresh browser OAuth flow instead of a stored secret — never here.
# OPENAI_API_KEY=op://Claw Keys/openai/credential
# ANTHROPIC_API_KEY=op://Claw Keys/anthropic/credential
# Future: video model keys, etc.
