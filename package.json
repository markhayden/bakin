{
  "name": "bakin",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "bin": {
    "bakin": "./cli/bakin.ts"
  },
  "scripts": {
    "dev": "bun run server.ts",
    "build": "bun run build:vendors && bun run build:plugins && bun run build:host-shell && bun run build:binary",
    "build:host": "bun run build:vendors && bun run build:host-shell",
    "build:host-shell": "bun run packages/host/build.ts",
    "build:vendors": "bun run scripts/build-vendors.ts",
    "build:plugins": "bun run scripts/build-plugins.ts",
    "build:assets-manifest": "bun run scripts/generate-embedded-assets.ts",
    "build:binary": "bun run scripts/build-binary.ts",
    "start": "bun run server.ts",
    "lint": "eslint src plugins tests scripts dev cli server.ts bakin.config.ts next.config.ts vitest.config.ts eslint.config.mjs",
    "lint:home-bypasses": "bun run scripts/bin/check-home-bypasses.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "test": "vitest run",
    "test:components": "vitest run tests/components",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "dev:mock": "bun run dev/imitation-crab/index.ts --with-bakin",
    "dev:docker": "OPENCLAW_HOME=./dev/openclaw-home OPENCLAW_PATH=./dev/docker/openclaw-shim.sh BAKIN_URL=http://host.docker.internal:3737 bun run server.ts",
    "docker:setup": "bash dev/docker/setup.sh",
    "docker:up": "docker compose -f dev/docker/docker-compose.yml up -d openclaw-gateway",
    "docker:down": "docker compose -f dev/docker/docker-compose.yml down",
    "mock:start": "bun run dev/imitation-crab/index.ts",
    "mock:seed": "bun run dev/imitation-crab/seed.ts",
    "cli": "bun run cli/bakin.ts"
  },
  "dependencies": {
    "@antfly/sdk": "^0.0.14",
    "@bakin/core": "workspace:*",
    "@base-ui/react": "^1.3.0",
    "@dagrejs/dagre": "^1.1.8",
    "@dnd-kit/abstract": "^0.3.2",
    "@dnd-kit/dom": "^0.3.2",
    "@dnd-kit/helpers": "^0.3.2",
    "@dnd-kit/react": "^0.3.2",
    "@hookform/resolvers": "^5.2.2",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/router-devtools": "^1.166.13",
    "@types/js-yaml": "^4.0.9",
    "@types/nodemailer": "^7.0.11",
    "@xyflow/react": "^12.10.1",
    "ajv": "^8.18.0",
    "better-sqlite3": "^12.8.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.5.0",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.577.0",
    "next": "16.2.0",
    "nodemailer": "^8.0.3",
    "pdf-parse": "^2.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.72.0",
    "react-markdown": "^10.1.0",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "patchedDependencies": {
    "@antfly/sdk@0.0.14": "patches/@antfly__sdk@0.0.14.patch"
  },
  "trustedDependencies": [
    "better-sqlite3"
  ]
}
