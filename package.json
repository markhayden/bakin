{
  "name": "bakin",
  "version": "0.0.0-dev",
  "private": true,
  "workspaces": [
    "packages/*",
    "docs"
  ],
  "bin": {
    "bakin": "./cli/bakin.ts"
  },
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "prebuild": "bun run scripts/stamp-version.ts",
    "build": "bun run build:css && bun run build:vendors && bun run build:plugins && bun run build:host-shell && bun run build:assets-manifest && bun run build:assert-production-assets && bun run build:binary",
    "release": "bun run scripts/prep-release.ts",
    "build:host": "bun run build:css && bun run build:vendors && bun run build:host-shell",
    "build:css": "tailwindcss -i ./packages/host/src/globals.css -o ./packages/sdk/styles.css --minify",
    "build:host-shell": "bun run packages/host/build.ts",
    "build:vendors": "bun run scripts/build-vendors.ts",
    "build:plugins": "bun run scripts/build-plugins.ts",
    "build:assert-production-assets": "bun run scripts/assert-production-assets.ts",
    "build:assets-manifest": "bun run scripts/generate-embedded-assets.ts",
    "build:binary": "bun run scripts/build-binary.ts",
    "size:report": "bun run scripts/report-sizes.ts",
    "ui:baseline:capture": "bun run scripts/ui/baseline.ts capture",
    "ui:baseline:check": "bun run scripts/ui/baseline.ts check",
    "ui:tokens:generate": "bun run scripts/ui/generate-tokens.ts generate",
    "ui:tokens:check": "bun run scripts/ui/generate-tokens.ts check",
    "ui:census:generate": "bun run scripts/ui/census.ts generate",
    "ui:census:check": "bun run scripts/ui/census.ts check",
    "ui:public-api:generate": "bun run scripts/ui/public-api.ts generate",
    "ui:public-api:check": "bun run scripts/ui/public-api.ts check",
    "ui:governance:check": "bun run scripts/ui/conformance.ts governance",
    "ui:conformance": "bun run scripts/ui/conformance.ts",
    "ui:legacy-styles:generate": "bun run scripts/ui/check-legacy-styles.ts generate",
    "ui:legacy-styles:check": "bun run scripts/ui/check-legacy-styles.ts check",
    "ui:performance:generate": "bun run scripts/ui/performance.ts generate",
    "ui:performance": "bun run scripts/ui/performance.ts check",
    "ui:dev": "bun run build:css && storybook dev -p 6006 --exact-port --host 127.0.0.1 --no-open --disable-telemetry",
    "ui:build": "bun run scripts/ui/build-storybook.ts maintainer",
    "ui:build:public": "bun run scripts/ui/build-storybook.ts public",
    "ui:build:public:verify": "bun run scripts/ui/build-storybook.ts public --verify-determinism",
    "ui:test:serve": "bun run ui:build:public && node scripts/ui/serve-storybook.mjs",
    "ui:test:visual": "bun run scripts/ui/run-visual-tests.ts",
    "ui:test:visual:teeth": "bun run scripts/ui/verify-visual-teeth.ts",
    "ui:snapshots:update": "bun run scripts/ui/update-snapshots.ts",
    "ui:test:stories": "vitest --run --project=storybook",
    "ui:test:stories:teeth": "bun run scripts/ui/verify-story-teeth.ts",
    "ui:test:browsers": "bun run scripts/ui/run-browser-tests.ts",
    "ui:test:browsers:teeth": "bun run scripts/ui/verify-browser-teeth.ts",
    "ui:test:conformance": "bun run scripts/ui/verify-plugin-conformance.ts",
    "prestart": "bun run build:css && bun run build:vendors && bun run build:plugins && bun run build:host-shell && bun run build:assets-manifest",
    "start": "bun run prestart && bun run server.ts serve",
    "server": "bun run server.ts serve",
    "lint": "eslint src packages plugins tests scripts storybook .storybook dev cli server.ts bakin.config.ts playwright.ui.config.ts playwright.browser.config.ts vitest.config.ts eslint.config.mjs",
    "lint:home-bypasses": "bun run scripts/bin/check-home-bypasses.mjs",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "check:cycles": "bun scripts/check-cycles.ts",
    "test": "bun test --parallel=4 --isolate --timeout 15000 --path-ignore-patterns \"dev/**\"",
    "test:components": "bun test --isolate tests/components",
    "test:watch": "bun test --watch --isolate --path-ignore-patterns \"dev/**\"",
    "test:coverage": "bun test --isolate --coverage --path-ignore-patterns \"dev/**\"",
    "docs:generate": "bun run ui:tokens:generate && bun run scripts/docs/generate.ts",
    "docs:dev": "bun run --cwd docs dev",
    "docs:validate": "bun run scripts/docs/check.ts",
    "docs:validate:routes": "bun run scripts/docs/route-contract-check.ts",
    "docs:build:site": "bun run --cwd docs build",
    "docs:build:combined": "bun run docs:build:site && bun run ui:build:public && bun run scripts/docs/integrate-ui-catalog.ts",
    "docs:build": "bun run docs:generate && bun run docs:build:combined",
    "docs:screenshots": "bun run scripts/docs/capture-screenshots.ts",
    "verify:health-ui": "bun run scripts/verify-health-ui.ts",
    "docs:inject-screenshots": "bun run scripts/docs/inject-screenshots.ts",
    "docs:check": "bun run docs:generate && bun run docs:validate && bun run docs:validate:routes && bun run docs:build:combined",
    "cli:tui-gallery": "bun run scripts/cli-tui-gallery.tsx",
    "dev:mock": "bun run dev/imitation-crab/index.ts --with-bakin",
    "dev:docker": "OPENCLAW_HOME=./dev/openclaw-home OPENCLAW_PATH=./dev/docker/openclaw-shim.sh BAKIN_URL=http://host.docker.internal:3737 bun run server.ts serve",
    "instance": "bun run scripts/instance.ts",
    "docker:up": "docker compose -f dev/docker/docker-compose.yml up -d openclaw-gateway",
    "docker:down": "docker compose -f dev/docker/docker-compose.yml down",
    "mock:start": "bun run dev/imitation-crab/index.ts",
    "mock:seed": "bun run dev/imitation-crab/seed.ts",
    "cli": "bun run cli/bakin.ts"
  },
  "dependencies": {
    "@bakin/core": "workspace:*",
    "@base-ui/react": "^1.3.0",
    "@dagrejs/dagre": "^1.1.8",
    "@dnd-kit/abstract": "^0.3.2",
    "@dnd-kit/dom": "^0.3.2",
    "@dnd-kit/helpers": "^0.3.2",
    "@dnd-kit/react": "^0.3.2",
    "@inkjs/ui": "^2.0.0",
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@tanstack/react-router": "^1.168.23",
    "@tanstack/router-devtools": "^1.166.13",
    "@xyflow/react": "^12.10.1",
    "ajv": "^8.18.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cron-parser": "^5.5.0",
    "ink": "^7.0.2",
    "js-yaml": "^4.1.1",
    "lucide-react": "^0.577.0",
    "nodemailer": "^8.0.3",
    "pdf-parse": "^2.4.5",
    "postcss": "8.5.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "~4.3.0",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "5.2.8",
    "@fontsource/jetbrains-mono": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "@happy-dom/global-registrator": "^20.9.0",
    "@makinbakin/sdk": "workspace:*",
    "@storybook/addon-a11y": "10.5.2",
    "@storybook/addon-docs": "10.5.2",
    "@storybook/addon-vitest": "10.5.2",
    "@storybook/react-vite": "10.5.2",
    "@tailwindcss/cli": "^4.2.4",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.13",
    "@types/js-yaml": "^4.0.9",
    "@types/nodemailer": "^7.0.11",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.10",
    "axe-core": "4.12.1",
    "eslint": "^9",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "madge": "^8.0.0",
    "playwright": "^1.60.0",
    "sharp": "^0.34.5",
    "storybook": "10.5.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8.59.0",
    "vite": "7.3.2",
    "vitest": "4.1.10"
  }
}
